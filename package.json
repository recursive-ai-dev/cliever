    "kira:check": "node scripts/build-kira-module.mjs --check",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:kira": "npm --prefix kira run verify"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.2.0"
  }
